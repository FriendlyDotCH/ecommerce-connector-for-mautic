<div class="tab-pane fade in bdr-w-0" id="ecommerce-container">
    <div class="row mb-md">
        <div class="col-sm-6 col-md-3">
            <div class="panel panel-default mb-0">
                <div class="panel-body text-center">
                    <h5 class="fw-sb mb-xs">{{ 'mautic.plugin.ecommerce.field.lifetime_value'|trans }}</h5>
                    <p class="text-secondary mb-0">{{ lifetimeValueFormatted|purify }}</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="panel panel-default mb-0">
                <div class="panel-body text-center">
                    <h5 class="fw-sb mb-xs">{{ 'mautic.plugin.ecommerce.field.order_count'|trans }}</h5>
                    <p class="text-secondary mb-0">{{ stats.order_count }}</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="panel panel-default mb-0">
                <div class="panel-body text-center">
                    <h5 class="fw-sb mb-xs">{{ 'mautic.plugin.ecommerce.field.last_order_date'|trans }}</h5>
                    <p class="text-secondary mb-0">
                        {% if stats.last_order_date %}
                            {{ dateToText(stats.last_order_date, 'UTC', 'Y-m-d H:i:s', true) }}
                        {% else %}
                            {{ 'mautic.core.no.info'|trans }}
                        {% endif %}
                    </p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="panel panel-default mb-0">
                <div class="panel-body text-center">
                    <h5 class="fw-sb mb-xs">{{ 'mautic.plugin.ecommerce.field.last_order_total'|trans }}</h5>
                    <p class="text-secondary mb-0">
                        {% if lastOrderTotalFormatted %}
                            {{ lastOrderTotalFormatted|purify }}
                        {% else %}
                            {{ 'mautic.core.no.info'|trans }}
                        {% endif %}
                    </p>
                </div>
            </div>
        </div>
    </div>

    {% if timing is defined and timing.daysSinceLastOrder is not null %}
        <div class="row mb-md">
            <div class="col-sm-6 col-md-3">
                <div class="panel panel-default mb-0">
                    <div class="panel-body text-center">
                        <h5 class="fw-sb mb-xs">{{ 'mautic.plugin.ecommerce.field.days_since_last_order'|trans }}</h5>
                        <p class="text-secondary mb-0">{{ timing.daysSinceLastOrder|number_format(0) }}</p>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="panel panel-default mb-0">
                    <div class="panel-body text-center">
                        <h5 class="fw-sb mb-xs">{{ 'mautic.plugin.ecommerce.field.avg_days_between_orders'|trans }}</h5>
                        <p class="text-secondary mb-0">{{ timing.avgDaysBetweenOrders is not null ? timing.avgDaysBetweenOrders|number_format(1) : 'mautic.core.no.info'|trans }}</p>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="panel panel-default mb-0">
                    <div class="panel-body text-center">
                        <h5 class="fw-sb mb-xs">{{ 'mautic.plugin.ecommerce.field.next_order_date'|trans }}</h5>
                        <p class="text-secondary mb-0">{{ timing.nextOrderDate ? dateToDate(timing.nextOrderDate, 'UTC') : 'mautic.core.no.info'|trans }}</p>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="panel panel-default mb-0">
                    <div class="panel-body text-center">
                        <h5 class="fw-sb mb-xs">{{ 'mautic.plugin.ecommerce.field.lifecycle_stage'|trans }}</h5>
                        <p class="text-secondary mb-0">
                            {% if timing.lifecycleStage %}
                                <span class="label {{ timing.lifecycleStage in ['at_risk', 'lapsed'] ? 'label-warning' : (timing.lifecycleStage == 'vip' ? 'label-success' : 'label-default') }}">{{ ('mautic.plugin.ecommerce.stage.' ~ timing.lifecycleStage)|trans }}</span>
                                {% if timing.rfmScore %}<small class="ml-xs" title="{{ 'mautic.plugin.ecommerce.field.rfm_score'|trans }}">RFM {{ timing.rfmScore }}</small>{% endif %}
                            {% else %}
                                {{ 'mautic.core.no.info'|trans }}
                            {% endif %}
                        </p>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {% if behaviours is defined and behaviours is not empty %}
        <h5 class="fw-sb mb-sm">{{ 'mautic.plugin.ecommerce.behaviour.header.index'|trans }}</h5>
        <div class="row mb-md">
            {% for row in behaviours %}
                <div class="col-sm-6 col-md-3">
                    <div class="panel panel-default mb-sm">
                        <div class="panel-body text-center">
                            <h5 class="fw-sb mb-xs">
                                {% if securityIsGranted('lead:fields:full') %}
                                    <a href="{{ path('mautic_ecommerce_behaviour_action', {'objectAction': 'edit', 'objectId': row.behaviour.id}) }}" data-toggle="ajax">{{ row.behaviour.name }}</a>
                                {% else %}
                                    {{ row.behaviour.name }}
                                {% endif %}
                            </h5>
                            <p class="text-secondary mb-xs">{{ row.value|purify }}</p>
                            <small class="text-secondary">{{ include('@EcommerceConnector/Behaviour/_definition.html.twig', {'behaviour': row.behaviour}) }}</small>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {% if orders is empty %}
        {{ include('@MauticCore/Helper/no_information.html.twig', {'tip': 'mautic.plugin.ecommerce.tab.no_orders'}) }}
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                <tr>
                    <th class="timeline-icon np"></th>
                    {{ include('@MauticCore/Helper/tableheader.html.twig', {
                        'text': 'mautic.plugin.ecommerce.tab.order_number',
                        'class': 'visible-md visible-lg',
                    }) }}
                    {{ include('@MauticCore/Helper/tableheader.html.twig', {
                        'text': 'mautic.plugin.ecommerce.tab.line_items',
                        'class': 'visible-md visible-lg',
                    }) }}
                    {{ include('@MauticCore/Helper/tableheader.html.twig', {
                        'text': 'mautic.plugin.ecommerce.tab.order_total',
                        'class': 'visible-md visible-lg',
                    }) }}
                    {{ include('@MauticCore/Helper/tableheader.html.twig', {
                        'text': 'mautic.plugin.ecommerce.tab.location',
                        'class': 'visible-md visible-lg',
                    }) }}
                    {{ include('@MauticCore/Helper/tableheader.html.twig', {
                        'text': 'mautic.plugin.ecommerce.tab.source',
                        'class': 'visible-md visible-lg timeline-type',
                    }) }}
                    {{ include('@MauticCore/Helper/tableheader.html.twig', {
                        'text': 'mautic.plugin.ecommerce.tab.date',
                        'class': 'visible-md visible-lg timeline-timestamp',
                    }) }}
                </tr>
                </thead>
                <tbody>
                {% set lastDate = null %}
                {% for order in orders %}
                    {% set eventDate = dateToDate(order.dateAdded, 'local', 'Y-m-d H:i:s') %}
                    {% if lastDate != eventDate %}
                        {% set dateLabel = dateToText(order.dateAdded, 'local', 'Y-m-d H:i:s') %}
                        <tr class="timeline-date-header">
                            <td colspan="7" class="text-center">
                                <span size="md" class="label label-warm-gray" style="font-weight: normal; font-size:13px;">
                                    <i class="ri-time-line"></i>{{ dateLabel }}
                                </span>
                            </td>
                        </tr>
                        {% set lastDate = eventDate %}
                    {% endif %}
                    <tr class="timeline-row ecommerce-order-row {% if loop.index is divisible by(2) %}timeline-row-highlighted{% endif %}"
                        style="cursor: pointer;"
                        data-toggle="modal"
                        data-target="#ecommerce-order-modal-{{ order.id }}"
                        title="{{ 'mautic.plugin.ecommerce.tab.view_order'|trans }}">
                        <td class="timeline-icon np">
                            <span class="fa ri-fw ri-shopping-cart-2-line"></span>
                        </td>
                        <td class="visible-md visible-lg">{{ order.orderId|purify }}</td>
                        <td class="visible-md visible-lg">
                            {# Collapsed to an item count; clicking it shows the first three items here
                               (stopPropagation keeps the row from opening the order modal). #}
                            {% if order.items is empty %}
                                <span class="text-secondary">&mdash;</span>
                            {% else %}
                                <a href="#" class="ecommerce-order-items-toggle" onclick="event.preventDefault(); event.stopPropagation(); mQuery(this).next().toggleClass('hide');">
                                    {{ 'mautic.plugin.ecommerce.tab.item_count'|trans({'%count%': order.items|length}) }}
                                    <i class="ri-arrow-down-s-line"></i>
                                </a>
                                <div class="ecommerce-order-items hide">
                                    {% for item in order.items|slice(0, 3) %}
                                        <div>{{ item.qty }} &times; {{ item.itemName|purify }}</div>
                                    {% endfor %}
                                    {% if order.items|length > 3 %}
                                        <div class="text-secondary">+{{ order.items|length - 3 }}</div>
                                    {% endif %}
                                    <a href="#" class="small" data-toggle="modal" data-target="#ecommerce-order-modal-{{ order.id }}">{{ 'mautic.plugin.ecommerce.tab.view_order'|trans }}</a>
                                </div>
                            {% endif %}
                        </td>
                        <td class="visible-md visible-lg">
                            {{ order.orderTotalFormatted|purify }}
                            {{ include('@EcommerceConnector/Lead/_order_status.html.twig', {'order': order}) }}
                        </td>
                        <td class="visible-md visible-lg">
                            {% if order.location %}
                                {{ order.location|purify }}
                            {% else %}
                                {{ 'mautic.core.no.info'|trans }}
                            {% endif %}
                        </td>
                        <td class="timeline-type visible-md visible-lg">{{ order.orderSource|purify }}</td>
                        <td class="timeline-timestamp visible-md visible-lg">{{ dateToText(order.dateAdded, 'local', 'Y-m-d H:i:s', true) }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% for order in orders %}
            <div class="modal fade" id="ecommerce-order-modal-{{ order.id }}" tabindex="-1" role="dialog" aria-labelledby="ecommerce-order-modal-label-{{ order.id }}">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'mautic.core.close'|trans }}">
                                <span aria-hidden="true">&times;</span>
                            </button>
                            <h4 class="modal-title" id="ecommerce-order-modal-label-{{ order.id }}">
                                {{ 'mautic.plugin.ecommerce.tab.order_details'|trans({ '%order%': order.orderId })|purify }}
                            </h4>
                        </div>
                        <div class="modal-body" style="max-height: calc(100vh - 200px); overflow-y: auto;">
                            {{ include('@EcommerceConnector/Lead/order_details.html.twig', {'order': order}) }}
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary" data-dismiss="modal">
                                {{ 'mautic.core.close'|trans }}
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}
    {# Storefront activity: product views, carts (one row per cart, latest contents) and checkouts. #}
    {% if activity is defined %}
        <h5 class="fw-sb mb-xs mt-lg">{{ 'mautic.plugin.ecommerce.activity.title'|trans }}</h5>
        <p class="text-secondary small mb-sm">{{ 'mautic.plugin.ecommerce.activity.intro'|trans({'%days%': activityRetentionDays}) }}</p>
        {% if activity is empty %}
            <p class="text-secondary ecommerce-activity-empty">{{ 'mautic.plugin.ecommerce.activity.empty'|trans }}</p>
        {% else %}
            <div class="table-responsive">
                <table class="table table-condensed ecommerce-activity">
                    <thead>
                    <tr>
                        <th>{{ 'mautic.plugin.ecommerce.activity.type'|trans }}</th>
                        <th>{{ 'mautic.plugin.ecommerce.activity.products'|trans }}</th>
                        <th class="text-right">{{ 'mautic.plugin.ecommerce.activity.value'|trans }}</th>
                        <th>{{ 'mautic.plugin.ecommerce.activity.status'|trans }}</th>
                        <th>{{ 'mautic.plugin.ecommerce.tab.date'|trans }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for row in activity %}
                        <tr class="ecommerce-activity-row ecommerce-activity-{{ row.kind }}">
                            <td>{{ ('mautic.plugin.ecommerce.timeline.' ~ row.kind)|trans }}</td>
                            <td>
                                {% for product in row.products %}<div>{{ product|purify }}</div>{% else %}&mdash;{% endfor %}
                            </td>
                            <td class="text-right">{{ row.value ? row.value|purify : '' }}</td>
                            <td>
                                {% if row.status %}
                                    {% set statusClass = {'abandoned': 'label-warning', 'ordered': 'label-success', 'open': 'label-default'}[row.status] %}
                                    <span class="label {{ statusClass }}">{{ ('mautic.plugin.ecommerce.activity.status.' ~ row.status)|trans }}</span>
                                {% endif %}
                            </td>
                            <td>{{ dateToText(row.at, 'UTC', 'Y-m-d H:i:s', true) }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    {% endif %}
</div>
